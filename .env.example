NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=pastoral
DB_USER=pastoral_app
DB_PASSWORD=change_me
DB_SCHEMA=pastoral
DB_SSL=false
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_SLOW_QUERY_MS=500

JWT_SECRET=change_me_with_at_least_32_characters
JWT_EXPIRES_IN=8h
FILES_STORAGE_PATH=./storage
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:4200

# Integração: servidor PostgreSQL 17+ com permissão CREATEDB e extensões
# pgcrypto/pg_trgm. Se omitidas, usa a conexão DB_* somente para criar
# um NOVO banco pastoral_test_<uuid>, nunca para limpar o DB_NAME.
# TEST_DB_ADMIN_HOST=localhost
# TEST_DB_ADMIN_PORT=5432
# TEST_DB_ADMIN_USER=pastoral_test_admin
# TEST_DB_ADMIN_PASSWORD=change_me
